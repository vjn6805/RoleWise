NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://career:career-password@localhost:5432/career
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGINS=http://localhost:5173
EXTENSION_ORIGINS=
TRUST_PROXY=false

# Optional external job discovery. Leave unset for local-first development.
SERPAPI_KEY=
SERPAPI_URL=https://serpapi.com/search.json

# Optional evidence-selection provider. Deterministic grounding works without it.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Resume parser: none, apilayer, gemini, or openai-compatible.
# APILayer subscription/key: https://apilayer.com/marketplace/resume_parser-api
# none uses the deterministic parser; apilayer uploads your original resume to APILayer.
RESUME_AI_PROVIDER=none
APILAYER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
